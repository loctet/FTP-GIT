{
  "name": "ftpgit-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Local FTP / FTPS / SSH file manager with a web UI, SSH terminal and Git push-to-deploy",
  "keywords": [
    "ftp",
    "ftps",
    "sftp",
    "ssh",
    "deploy",
    "git",
    "git-deploy",
    "push-to-deploy",
    "file-manager",
    "terminal",
    "shared-hosting",
    "vite",
    "react"
  ],
  "author": "Elvis KONJOH",
  "license": "MIT",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js --open",
    "serve": "node server/index.js",
    "test": "node test/e2e.js"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "^6.2.2",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "ftp-srv": "^4.6.3"
  }
}
